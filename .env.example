# --- Supabase ---
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co

# Service role key — SECRET, server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# The address students' welcome emails and your admin notification are sent from.
# Must be a domain you've verified in Resend (or use onboarding@resend.dev for testing).
EMAIL_FROM=SSC Prep Sathi <hello@yourdomain.com>

# Where new pre-registration notifications are sent
ADMIN_NOTIFICATION_EMAIL=you@yourdomain.com
